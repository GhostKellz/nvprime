# NVPrime udev rules for NVIDIA GPU access
# Maintainer: Christopher Kelley <ckelley@ghostkellz.sh>

# Allow video group to access NVIDIA devices
KERNEL=="nvidia*", MODE="0666", GROUP="video"
KERNEL=="nvidia-uvm*", MODE="0666", GROUP="video"

# DRM device access for primetime compositor
KERNEL=="card[0-9]*", SUBSYSTEM=="drm", MODE="0666", GROUP="video"
KERNEL=="renderD*", SUBSYSTEM=="drm", MODE="0666", GROUP="render"

# NVFBC access for streaming
KERNEL=="nvidia-fbc*", MODE="0666", GROUP="video"

# Power management access (for nvpower)
SUBSYSTEM=="hwmon", ATTR{name}=="nvidia", MODE="0664", GROUP="video"

# Trigger nvprime reload on GPU hotplug (eGPU support)
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", RUN+="/usr/bin/nvprime reload"
